{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": "${AllowedOrigins}",
  "Cloudinary": {
    "CloudName": "${Cloudinary__CloudName}",
    "ApiKey": "${Cloudinary__ApiKey}",
    "ApiSecret": "${Cloudinary__ApiSecret}"
  },
  "Jwt": {
    "Secret": "${Jwt__Secret}",
    "Issuer": "${Jwt__Issuer}",
    "Audience": "${Jwt__Audience}"
  },
  "EmailNotification": {
    "Enabled": false,
    "ResendApiKey": "${RESEND_API_KEY}",
    "AdminEmail": "${ADMIN_EMAIL}",
    "From": "${EmailNotification__From}"
  },
  "ConnectionStrings": {
    "DefaultConnection": "${ConnectionStrings__DefaultConnection}"
  }
}
